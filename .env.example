# Пример настроек ALONG. Скопируйте в .env и заполните своими значениями.

# dev | prod. В prod включаются secure-cookie и HSTS.
ALONG_ENV=dev

# Секрет Flask. Если пусто — берётся из app/.secret (создаётся автоматически).
ALONG_SECRET_KEY=

# Путь к базе SQLite. По умолчанию app/along.db.
ALONG_DB=

# Адрес, по которому сервис доступен снаружи (для ссылок в письмах).
ALONG_BASE_URL=http://127.0.0.1:5055

# 1 — cookie only-over-HTTPS и заголовок HSTS. Включайте только за TLS.
ALONG_SECURE_COOKIES=0

# Пароли демо-аккаунтов при первичном создании базы (seed).
ALONG_ADMIN_PASSWORD=
ALONG_USER_PASSWORD=

# SMTP. Если ALONG_SMTP_HOST пуст — письма не уходят (демо-режим).
ALONG_SMTP_HOST=
ALONG_SMTP_PORT=587
ALONG_SMTP_USER=
ALONG_SMTP_PASSWORD=
ALONG_SMTP_FROM=
ALONG_SMTP_SSL=0

# Адрес поддержки: показывается на /support и получает копии обращений.
ALONG_SUPPORT_EMAIL=support@along.local

# Прод-запуск (run_prod.py)
ALONG_HOST=0.0.0.0
ALONG_PORT=5055
ALONG_THREADS=8
